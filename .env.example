# LinguaHub environment.
# Copy this file to .env and fill in the secrets

# --- Postgres: users ---
POSTGRES_USERS_DB=linguahub_users
POSTGRES_USERS_USER=linguahub
POSTGRES_USERS_PASSWORD=change-me
POSTGRES_USERS_PORT=5436

# --- Postgres: keycloak ---
POSTGRES_KEYCLOAK_DB=keycloak
POSTGRES_KEYCLOAK_USER=linguahub
POSTGRES_KEYCLOAK_PASSWORD=change-me

# --- Postgres: bookings ---
POSTGRES_BOOKINGS_DB=linguahub_bookings
POSTGRES_BOOKINGS_USER=linguahub
POSTGRES_BOOKINGS_PASSWORD=change-me
POSTGRES_BOOKINGS_PORT=5433

# --- Postgres: payments ---
POSTGRES_PAYMENTS_DB=linguahub_payments
POSTGRES_PAYMENTS_USER=linguahub
POSTGRES_PAYMENTS_PASSWORD=change-me
POSTGRES_PAYMENTS_PORT=5435

# --- Ports on the host ---
DISCOVERY_SERVER_PORT=8761
KEYCLOAK_PORT=8180
API_GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
BOOKING_SERVICE_PORT=8082
PAYMENT_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084

# --- Stripe (test mode) ---
# Secret key: Stripe dashboard, Developers, API keys
STRIPE_SECRET_KEY=sk_test_replace_me
# Signing secret printed by: stripe listen --forward-to localhost:8080/api/v1/payments/webhook
# Keep a placeholder if you skip webhooks, the redirect to /success settles the payment anyway
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Resend (email) ---
# The free test sender only delivers to the address of the Resend account owner
RESEND_API_KEY=re_replace_me

# --- Keycloak ---
# Any long random string, for example: openssl rand -base64 32
# Read by both the realm import and user-service, so set it once
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me